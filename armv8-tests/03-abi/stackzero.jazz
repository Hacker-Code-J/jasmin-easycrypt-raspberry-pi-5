// A function that spreads a secret over a 256-byte stack buffer. The three
// variants differ only by their stack-zeroization strategy; the native
// harness measures how much of the secret is left on the stack on return.

inline
fn spread(reg u64 key) -> reg u64 {
  stack u64[32] buf;
  reg u64 acc v;
  inline int i;
  for i = 0 to 32 {
    v = key;
    v = v <<r i;
    v ^= key;
    buf[i] = v;
  }
  acc = 0;
  for i = 0 to 32 { v = buf[i]; acc += v; }
  return acc;
}

export fn sz_none(reg u64 key) -> reg u64 { key = spread(key); return key; }

#[stackzero=loop]
export fn sz_loop(reg u64 key) -> reg u64 { key = spread(key); return key; }

#[stackzero=unrolled]
export fn sz_unrolled(reg u64 key) -> reg u64 { key = spread(key); return key; }

// #[stackzero=loopSCT] is rejected on ARMv8-A ("not supported"): see 08-negative.
